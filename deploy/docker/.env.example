# Copy to .env next to docker-compose.yml and fill in. Keep .env out of git.

# Image to run: built and pushed by .github/workflows/enterprise-docker.yml.
FRPS_IMAGE=ghcr.io/czwstc/frps-enterprise:latest

# Token frpc clients log in with (auth.token).
FRPS_TOKEN=change-me-to-a-long-random-token

# The local dashboard account. Its first login sets up TOTP and shows
# recovery keys; later logins need the password and a TOTP code.
FRPS_ADMIN_USER=admin
FRPS_ADMIN_PASSWORD=change-me-at-least-8-chars

# OIDC (e.g. Synology SSO). The redirect URL must be registered at the
# provider; frps serves the callback at its path.
FRPS_OIDC_ISSUER=https://nas.example.com:5001/webman/sso
FRPS_OIDC_CLIENT_ID=
FRPS_OIDC_CLIENT_SECRET=
FRPS_OIDC_REDIRECT_URL=https://frp.example.com/relay
FRPS_OIDC_NAME="群晖 SSO"
